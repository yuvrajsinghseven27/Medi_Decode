# MediDecode Application Environment Variables
PROJECT_NAME="MediDecode API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Gemini AI Credentials
GEMINI_API_KEY="your-gemini-api-key-here"

# Database Configuration (PostgreSQL Async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/medidecode"
